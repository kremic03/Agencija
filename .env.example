# Kopiraj ovaj fajl u .env.local i upiši prave vrednosti.
# .env.local se nikada ne postavlja na GitHub.

# API ključ sa https://resend.com/api-keys
RESEND_API_KEY=

# Adresa na koju stižu upiti sa kontakt forme
CONTACT_TO_EMAIL=

# Adresa pošiljaoca (mora biti sa domena verifikovanog u Resend-u;
# za testiranje može onboarding@resend.dev)
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Javna adresa sajta (za kanonske URL-ove, sitemap i slike za deljenje)
# Ugrađuje se pri build-u, pa na hostingu mora biti postavljena pre build-a
# (na produkciji: https://webdron.rs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postaviti na true tek kada sajt bude spreman za indeksiranje u pretraživačima
# Uz true, build pada ako NEXT_PUBLIC_SITE_URL nije javna https adresa
NEXT_PUBLIC_SITE_INDEXABLE=false
